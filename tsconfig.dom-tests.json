{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["es2024", "dom"],
    "types": ["node"],
    "isolatedDeclarations": false,
    "rootDir": ".",
    "outDir": ".tsbuild/dom-tests",
    "tsBuildInfoFile": ".tsbuild/dom-tests/tsconfig.tsbuildinfo"
  },
  "include": [
    "packages/ui/src/globals.d.ts",
    "packages/*/src/**/*.vibe.test.ts",
    "packages/ui/test/vibe.d.ts",
    "packages/compiler/src/hmr.integration.test.ts",
    "packages/compiler/src/template-roundtrip.test.ts"
  ],
  "references": [{ "path": "packages/ui" }, { "path": "packages/compiler" }]
}
