{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["es2024"],
    "types": ["node"],
    "isolatedDeclarations": false,
    "rootDir": ".",
    "outDir": ".tsbuild/tools"
  },
  "include": [
    "scripts/**/*.ts",
    "*.config.ts",
    "tsdown.base.ts",
    "packages/*/tsdown.config.ts",
    "packages/ui/vitest.setup.ts",
    "packages/ui/src/globals.d.ts",
    "packages/ui/src/**/*.integration.test.ts"
  ],
  "references": [{ "path": "packages/errors" }, { "path": "packages/ui" }]
}
