exports[`command matrix > human: vibejs  exits 0 > output 1`] = `
"vibejs 1.2.3

vibejs explain <code>
  Explain a VIBE error code from the bundled catalog, offline.
  $ vibejs explain VIBE8003

vibejs docs <query...>
  Look up a VIBE code, open a docs page by path, or search the bundled docs, offline.
  $ vibejs docs VIBE8003
  $ vibejs docs errors/VIBE8004
  $ vibejs docs "unknown option"

vibejs check [--only types,lint,format,test] [--fix] [--max N]
  Type-check, lint, format-check and test the project with coverage, concurrently.
  $ vibejs check
  $ vibejs check --only types,lint
  $ vibejs check --fix --max 50
  --only  Run only these steps: types, lint, format, test.
  --fix  Apply lint fixes and format the files first.
  --max  Show at most N diagnostics (default 20).

vibejs dev [--port N]
  Serve the UI and the backend on one port, restarting the backend on server changes.
  $ vibejs dev
  $ vibejs dev --port 5173
  --port  Listen on exactly this port (default: a free one from 5173).

vibejs build
  Build the UI into ui/dist and the server into server/dist/main.js.
  $ vibejs build

vibejs errors [--limit N]
  List the unresolved build errors and the latest runtime errors from .vibejs/dev.log.
  $ vibejs errors
  $ vibejs errors --limit 5
  --limit  Show at most N runtime errors (default 20).

vibejs logs [--limit N] [--level error|warn|info|debug] [--source vite|browser|server|vibejs] [--grep TEXT] [--since ISO|<n>s|<n>m|<n>h]
  Show the newest .vibejs/dev.log entries, filtered by level, source, text and time.
  $ vibejs logs --level warn
  $ vibejs logs --source server --since 5m
  --limit  Show at most N entries (default 50).
  --level  The lowest level shown: error, warn, info or debug.
  --source  Only this source: vite, browser, server or vibejs.
  --grep  Only messages that contain TEXT, ignoring case.
  --since  Only entries since an ISO time or <n>s, <n>m, <n>h ago.

vibejs agents sync [--check]
  Write the vibe.js rules block into AGENTS.md and \`@AGENTS.md\` into CLAUDE.md.
  $ vibejs agents sync
  $ vibejs agents sync --check
  --check  Write nothing; fail when a file is out of date.

vibejs di [--module NAME] [--token NAME]
  Show the modules and providers of the backend, without constructing any provider.
  $ vibejs di
  $ vibejs di --token TodosService
  --module  Only the module NAME, wherever it is imported.
  --token  Only the modules that provide or export NAME.

vibejs request <METHOD> <path> [--data JSON|@file] [-H 'Name: value']...
  Call an API route: through the running dev server, or in process when none runs.
  $ vibejs request GET /api/todos
  $ vibejs request POST /api/todos --data '{"title":"Write docs"}'
  --data  The JSON body, inline or as @file.
  -H, --header  A request header, 'Name: value'; repeatable.

Global options:
  --json  Print one JSON object (on by default in agent mode).
  -h, --help  Describe the commands and their options.
  --version  Print the vibejs version.
"
`;

exports[`command matrix > human: vibejs --help exits 0 > output 1`] = `
"vibejs 1.2.3

vibejs explain <code>
  Explain a VIBE error code from the bundled catalog, offline.
  $ vibejs explain VIBE8003

vibejs docs <query...>
  Look up a VIBE code, open a docs page by path, or search the bundled docs, offline.
  $ vibejs docs VIBE8003
  $ vibejs docs errors/VIBE8004
  $ vibejs docs "unknown option"

vibejs check [--only types,lint,format,test] [--fix] [--max N]
  Type-check, lint, format-check and test the project with coverage, concurrently.
  $ vibejs check
  $ vibejs check --only types,lint
  $ vibejs check --fix --max 50
  --only  Run only these steps: types, lint, format, test.
  --fix  Apply lint fixes and format the files first.
  --max  Show at most N diagnostics (default 20).

vibejs dev [--port N]
  Serve the UI and the backend on one port, restarting the backend on server changes.
  $ vibejs dev
  $ vibejs dev --port 5173
  --port  Listen on exactly this port (default: a free one from 5173).

vibejs build
  Build the UI into ui/dist and the server into server/dist/main.js.
  $ vibejs build

vibejs errors [--limit N]
  List the unresolved build errors and the latest runtime errors from .vibejs/dev.log.
  $ vibejs errors
  $ vibejs errors --limit 5
  --limit  Show at most N runtime errors (default 20).

vibejs logs [--limit N] [--level error|warn|info|debug] [--source vite|browser|server|vibejs] [--grep TEXT] [--since ISO|<n>s|<n>m|<n>h]
  Show the newest .vibejs/dev.log entries, filtered by level, source, text and time.
  $ vibejs logs --level warn
  $ vibejs logs --source server --since 5m
  --limit  Show at most N entries (default 50).
  --level  The lowest level shown: error, warn, info or debug.
  --source  Only this source: vite, browser, server or vibejs.
  --grep  Only messages that contain TEXT, ignoring case.
  --since  Only entries since an ISO time or <n>s, <n>m, <n>h ago.

vibejs agents sync [--check]
  Write the vibe.js rules block into AGENTS.md and \`@AGENTS.md\` into CLAUDE.md.
  $ vibejs agents sync
  $ vibejs agents sync --check
  --check  Write nothing; fail when a file is out of date.

vibejs di [--module NAME] [--token NAME]
  Show the modules and providers of the backend, without constructing any provider.
  $ vibejs di
  $ vibejs di --token TodosService
  --module  Only the module NAME, wherever it is imported.
  --token  Only the modules that provide or export NAME.

vibejs request <METHOD> <path> [--data JSON|@file] [-H 'Name: value']...
  Call an API route: through the running dev server, or in process when none runs.
  $ vibejs request GET /api/todos
  $ vibejs request POST /api/todos --data '{"title":"Write docs"}'
  --data  The JSON body, inline or as @file.
  -H, --header  A request header, 'Name: value'; repeatable.

Global options:
  --json  Print one JSON object (on by default in agent mode).
  -h, --help  Describe the commands and their options.
  --version  Print the vibejs version.
"
`;

