{
  "name": "@vibejs-org/cli",
  "version": "0.0.0",
  "description": "The vibejs command line: dev server, checks, generators, JSON output and an MCP server for coding agents.",
  "keywords": [
    "ai-agents",
    "cli",
    "mcp",
    "typescript",
    "vibejs"
  ],
  "homepage": "https://github.com/vibejs/vibejs#readme",
  "bugs": {
    "url": "https://github.com/vibejs/vibejs/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vibejs/vibejs.git",
    "directory": "packages/cli"
  },
  "bin": {
    "vibejs": "./dist/bin.js"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prebuild": "pnpm -w errors",
    "build": "tsdown && node ../../docs/scripts/docs.ts bundle dist/docs && node --input-type=module -e \"import { mkdirSync, readFileSync } from 'node:fs'; import { renderBlock, syncAgentFiles } from './src/agents.ts'; mkdirSync('dist/agents'); syncAgentFiles('dist/agents', renderBlock('{{exec}}', readFileSync('dist/docs/index.txt', 'utf8').trim()), true);\""
  },
  "dependencies": {
    "@vibejs-org/errors": "workspace:*",
    "oxc-parser": "catalog:",
    "srvx": "catalog:",
    "std-env": "catalog:"
  },
  "devDependencies": {
    "@vibejs-org/compiler": "workspace:*",
    "@vibejs-org/contract": "workspace:*",
    "@vibejs-org/language-tools": "workspace:*",
    "@vibejs-org/server": "workspace:*",
    "@vibejs-org/ui": "workspace:*",
    "@vitest/coverage-v8": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:ts-next",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@vibejs-org/compiler": "workspace:*",
    "vite": "catalog:"
  },
  "peerDependenciesMeta": {
    "@vibejs-org/compiler": {
      "optional": true
    }
  },
  "engines": {
    "node": "^24.15.0 || >=26"
  }
}
