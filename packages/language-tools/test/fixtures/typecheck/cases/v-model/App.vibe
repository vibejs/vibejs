<script setup lang="ts">
import { ref } from '@vibejs-org/ui'
import Field from './Field.vibe'
const text = ref('')
const amount = ref(0)
const done = ref(false)
const picked = ref<string[]>([])
const tags = ref(new Set<string>())
const choice = ref('a')
const form = ref({ name: '' })
const note = ref<string>()
let draft = ''
const answer = ref('no')
const flag = ref<'on' | false>(false)
const level = ref(0)
</script>

<template>
  <input v-model="text">
  <input v-model.trim="form.name">
  <input v-model.number="amount">
  <input type="number" v-model="amount">
  <textarea v-model="draft"></textarea>
  <input type="checkbox" v-model="done">
  <input type="checkbox" value="a" v-model="picked">
  <select v-model="choice"><option>a</option></select>
  <select multiple v-model="tags"><option>a</option></select>
  <input type="radio" value="a" v-model="choice">
  <input type="checkbox" true-value="yes" false-value="no" v-model="answer">
  <input type="checkbox" :true-value="'on' as const" v-model="flag">
  <input type="radio" :value="1" v-model="level">
  <select v-model="level"><option :value="1">one</option></select>
  <Field v-model="text" />
  <Field v-model="text" v-model:count="amount" v-model:title.trim="note" />
  <Field v-model="text" v-model:first-name.trim="note" />
</template>
