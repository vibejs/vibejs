{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["es2024"],
    "types": ["node"],
    "isolatedDeclarations": false,
    "rootDir": ".",
    "outDir": ".tsbuild/tools"
  },
  "include": [
    "scripts/**/*.ts",
    "*.config.ts",
    "tsdown.base.ts",
    "packages/*/tsdown.config.ts",
    "packages/ui/vitest.setup.ts",
    "packages/ui/src/router/typed-routes.integration.test.ts",
    "packages/ui/src/globals.d.ts"
  ]
}
