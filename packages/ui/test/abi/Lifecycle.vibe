<script setup lang="ts">
import {
  onBeforeMount,
  onBeforeUnmount,
  onBeforeUpdate,
  onErrorCaptured,
  onMounted,
  onUnmounted,
  onUpdated,
  ref,
} from '@vibejs-org/ui';
import Leaf from './Leaf.vibe';

const { log } = defineProps<{ log: string[] }>();
const count = ref(0);

onBeforeMount(() => log.push('root beforeMount'));
onMounted(() => log.push('root mounted'));
onBeforeUpdate(() => log.push('root beforeUpdate'));
onUpdated(() => log.push('root updated'));
onBeforeUnmount(() => log.push('root beforeUnmount'));
onUnmounted(() => log.push('root unmounted'));
onErrorCaptured((err, instance, info) => {
  log.push(`captured ${(err as Error).message} from ${instance?.name} in ${info}`);
  return false;
});
</script>

<template>
  <div>
    <button type="button" @click="count++">{{ count }}</button>
    <Leaf :log="log" :count="count" />
  </div>
</template>
