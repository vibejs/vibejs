<script setup lang="ts">
import { ref } from '@usevibejs/ui';

defineSlots<{
  default?: (props: { count: number }) => unknown;
  header?: () => unknown;
  footer?: () => unknown;
}>();

const count = ref(0);
</script>

<template>
  <article>
    <header><slot name="header">Untitled</slot></header>
    <button type="button" @click="count++">More</button>
    <slot :count="count" />
    <footer><slot name="footer" /></footer>
  </article>
</template>
