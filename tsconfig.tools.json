{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["es2024", "dom"],
    "types": ["node"],
    "isolatedDeclarations": false,
    "rootDir": ".",
    "outDir": ".tsbuild/tools"
  },
  "include": [
    "scripts/**/*.ts",
    "*.config.ts",
    "tsdown.base.ts",
    "packages/*/tsdown.config.ts",
    "packages/ui/vitest.setup.ts",
    "packages/ui/src/globals.d.ts",
    "packages/ui/src/**/*.integration.test.ts",
    "packages/*/src/**/*.vibe.test.ts",
    "packages/ui/test/vibe.d.ts",
    "packages/contract/src/**/*.integration.test.ts",
    "packages/contract/test/fixtures/ui-bundle",
    "docs/scripts/docs.integration.test.ts"
  ],
  "references": [
    { "path": "packages/errors" },
    { "path": "packages/ui" },
    { "path": "packages/compiler" },
    { "path": "packages/contract" },
    { "path": "packages/create-vibejs" },
    { "path": "docs" }
  ]
}
