<template>
  <ul ref="list">
    <li v-for="item in items" :key="item.id" @click="pick(item.id)">{{ label }} {{ item.text }}</li>
  </ul>
</template>

<script setup lang="ts">
import { computed, ref, useTemplateRef } from '@vibejs-org/ui';
import type { Item } from './types';
import Child from './Child.vibe';

export interface Props {
  title: string;
  items?: Item[];
  size?: 'small' | 'large';
}

const { title, items = [], size: variant = 'small' } = defineProps<Props>();
const emit = defineEmits<{ pick: [id: number]; close: [] }>();
const slots = defineSlots<{ default?: (props: { item: Item }) => unknown }>();
const [query, queryModifiers] = defineModel<string>('query', { default: () => '' });
const checked = defineModel<boolean>({ required: true });

let clicks = 0;
const label = computed(() => `${title} (${variant})`);
const list = useTemplateRef<HTMLUListElement>('list');
const input = useTemplateRef('input');

function pick(id: number) {
  clicks++;
  emit('pick', id);
}

defineExpose({ pick, items });
defineOptions({ name: 'ItemList', inheritAttrs: false });
</script>
