<script setup lang="ts">
import { inject, onMounted, ref } from '@vibejs-org/ui';
import { API, type Api } from './api.ts';

const api = inject(API)!;

type Todo = { id: string; title: string; done: boolean };
type Result = Awaited<ReturnType<Api['todos'][keyof Api['todos']]>>;

const items = ref<Todo[]>([]);
const title = ref('');
// The last call's result: a later success clears a shown error.
const result = ref<Result>();

async function load() {
  const r = await api.todos.list();
  result.value = r;
  if (r.ok) items.value = r.data;
}

async function add() {
  const r = await api.todos.create({ body: { title: title.value } });
  result.value = r;
  if (r.ok) {
    items.value = [...items.value, r.data];
    title.value = '';
  }
}

async function toggle(id: string) {
  const r = await api.todos.toggle({ params: { id } });
  // On failure, re-sync from the server so the checkbox shows the real state.
  if (!r.ok) await load();
  result.value = r;
  if (r.ok) items.value = items.value.map((todo) => (todo.id === id ? r.data : todo));
}

onMounted(() => void load());
</script>

<template>
  <section>
    <form @submit.prevent="add">
      <input v-model="title" placeholder="What next?" />
      <button>Add</button>
    </form>
    <ul v-if="items.length">
      <li v-for="todo in items" :key="todo.id">
        <input type="checkbox" :checked="todo.done" @change="toggle(todo.id)" />
        {{ todo.title }}
      </li>
    </ul>
    <p v-else>Nothing to do.</p>
    <p v-if="result && !result.ok" class="error">{{ result.error.code }}</p>
  </section>
</template>
