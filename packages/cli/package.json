{
  "name": "@vibejs-org/cli",
  "version": "0.0.0",
  "description": "The vibejs command line: dev server, checks, generators, JSON output and an MCP server for coding agents.",
  "keywords": [
    "ai-agents",
    "cli",
    "mcp",
    "typescript",
    "vibejs"
  ],
  "homepage": "https://github.com/vibejs/vibejs#readme",
  "bugs": {
    "url": "https://github.com/vibejs/vibejs/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vibejs/vibejs.git",
    "directory": "packages/cli"
  },
  "bin": {
    "vibejs": "./dist/bin.js"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prebuild": "pnpm -w errors",
    "build": "tsdown && node ../../docs/scripts/docs.ts bundle dist/docs"
  },
  "dependencies": {
    "@vibejs-org/errors": "workspace:*",
    "srvx": "catalog:",
    "std-env": "catalog:"
  },
  "devDependencies": {
    "@vibejs-org/contract": "workspace:*",
    "@vibejs-org/server": "workspace:*",
    "@vitest/coverage-v8": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:ts-next",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "vite": "catalog:"
  },
  "engines": {
    "node": "^24.15.0 || >=26"
  }
}
