<template>
  <section class="todo" id="main">
    <h1>{{ props.title.toUpperCase() }}</h1>
    <p v-if="count > 0">{{ count }} items</p>
    <p v-else>Empty</p>
    <ul>
      <li v-for="(item, i) in items" :key="item.id">{{ i + 1 }}. {{ item.text }}</li>
    </ul>
    <Item :label="props.title" @click="increment(2)" @update:done.once="onDone">
      <template #footer="{ total }">{{ total }}</template>
    </Item>
    <!-- a comment {{ not interpolated }} -->
  </section>
</template>
