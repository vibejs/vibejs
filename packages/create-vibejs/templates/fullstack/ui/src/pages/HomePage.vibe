<script setup lang="ts">
import { computed, inject, useAsync } from '@usevibejs/ui';
import { API } from '../api.ts';

const api = inject(API)!;
// Loads on mount and is aborted when the page unmounts; failures are values, never thrown.
const { data } = useAsync((signal) => api.health.get(undefined, { signal }));
const status = computed(() =>
  data.value?.ok ? data.value.data.status : (data.value?.error.code ?? 'checking'),
);
</script>

<template>
  <h1>vibe.js</h1>
  <p>API status: <strong class="status">{{ status }}</strong></p>
</template>
