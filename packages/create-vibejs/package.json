{
  "name": "create-vibejs",
  "version": "0.1.0",
  "description": "Scaffolds a new vibe.js application.",
  "keywords": [
    "create",
    "scaffold",
    "template",
    "typescript",
    "vibejs"
  ],
  "homepage": "https://github.com/vibejs/vibejs#readme",
  "bugs": {
    "url": "https://github.com/vibejs/vibejs/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vibejs/vibejs.git",
    "directory": "packages/create-vibejs"
  },
  "bin": {
    "create-vibejs": "./bin.js"
  },
  "files": [
    "bin.js",
    "templates",
    "agents"
  ],
  "type": "module",
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').cpSync('node_modules/@usevibejs/cli/dist/agents', 'agents', { recursive: true })\""
  },
  "devDependencies": {
    "@usevibejs/cli": "workspace:*",
    "@usevibejs/errors": "workspace:*"
  },
  "engines": {
    "node": "^24.15.0 || >=26"
  }
}
