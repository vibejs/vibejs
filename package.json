{
  "name": "vibejs-monorepo",
  "private": true,
  "type": "module",
  "scripts": {
    "pretypecheck": "pnpm errors",
    "typecheck": "tsc -b && pnpm --dir packages/vscode typecheck",
    "lint": "tsc -b && pnpm --dir packages/vscode typecheck && oxlint --type-aware --deny-warnings --disable-nested-config && node scripts/lint-repo.ts && knip",
    "fmt": "oxfmt --disable-nested-config",
    "pretest": "pnpm errors",
    "test": "vitest --project node --project dom",
    "test:coverage": "vitest run --coverage --project node --project dom --project browser",
    "test:integration": "pnpm build && vitest run --project integration --project perf && pnpm --filter \"./examples/*\" test",
    "build": "pnpm -r --filter \"./packages/*\" build",
    "pack-check": "node scripts/pack-check.ts",
    "check": "pnpm errors --check && oxfmt --check --disable-nested-config && pnpm lint && pnpm test:coverage",
    "errors": "node scripts/errors.ts",
    "e2e": "node scripts/e2e.ts",
    "docs": "pnpm build && pnpm --dir docs build",
    "version-packages": "changeset version && pnpm errors && pnpm install --lockfile-only"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "catalog:",
    "@changesets/cli": "catalog:",
    "@types/node": "catalog:",
    "@types/vscode": "catalog:",
    "@usevibejs/compiler": "workspace:*",
    "@usevibejs/ui": "workspace:*",
    "@vitest/browser-playwright": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "jsdom": "catalog:",
    "knip": "catalog:",
    "oxc-parser": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "playwright": "catalog:",
    "publint": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^24.15.0",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.14.0"
}
