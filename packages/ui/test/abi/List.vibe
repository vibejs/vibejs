<script setup lang="ts">
import { computed, ref } from '@vibejs-org/ui';
import Item from './Item.vibe';

interface Entry {
  id: number;
  label: string;
  done: boolean;
}

const props = defineProps<{ title: string; items: Entry[] }>();

const filter = ref('');
const shown = computed(() => props.items.filter((item) => item.label.includes(filter.value)));
</script>

<template>
  <section class="list">
    <h2>{{ title }}</h2>
    <input v-model.trim="filter" />
    <p v-if="!shown.length">Nothing</p>
    <ul v-else>
      <Item
        v-for="(item, index) in shown"
        :key="item.id"
        :index="index"
        :label="item.label"
        :done="item.done"
      />
    </ul>
  </section>
</template>
