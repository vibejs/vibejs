<script setup lang="ts">
import { ref } from '@vibejs-org/ui';

const { start = 0, step = 1 } = defineProps<{ start?: number; step?: number }>();
const emit = defineEmits<{ change: [count: number] }>();

const count = ref(start);
function increment() {
  count.value += step;
  emit('change', count.value);
}

defineExpose({ count });
</script>

<template>
  <button type="button" @click.prevent="increment">Count: {{ count }}</button>
</template>
